RewriteEngine On

# index.html -> the directory's own root (avoids two URLs for the homepage)
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ ./ [NC,L,R=301]

# Visible redirect: page.html -> page (so the address bar updates)
RewriteCond %{THE_REQUEST} \s/+([^.\s]+)\.html[\s?] [NC]
RewriteRule ^ %1 [NC,L,R=301]

# Internal rewrite: page -> page.html (serves the file, URL stays clean)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^.]+)$ $1.html [NC,L]
